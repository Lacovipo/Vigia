# Nota: aquí estuvieron listados Cargo.toml y Cargo.lock, y no debían. Los dos
# se versionan (Cargo.toml lleva el número de versión, que es lo que el motor
# anuncia por UCI). La regla nunca llegó a morder porque git no ignora lo que
# ya rastrea, pero habría mordido en el primer clon limpio.

/target

__pycache__/

# Salidas de las tandas del banco de pruebas: pesan y se regeneran desde el
# manifiesto. Las configuraciones y los libros SÍ se versionan.
/banco/resultados/

# Notas del usuario con rutas locales de su equipo: se consultan en local,
# no se publican.
/docs/_Info_humano.md

# Ejecutables congelados de cada versión. Son artefactos: pesan, se
# reconstruyen desde su etiqueta de git, y los manifiestos del banco ya
# guardan el sha256 del que usó cada experimento.
/Release/

# Artefacto de Windows y OneDrive.
desktop.ini

# Corpus de entrenamiento de la red NNUE. Pesa gigas y se regenera con
# `generador datos` desde su semilla: la cabecera de cada fichero guarda la
# semilla, los nodos y el sha256 del generador y del fichero de aperturas.
/datos/

# Los checkpoints del entrenador: se regeneran, y lo que juega es el .bin
nets/*.pt
